{
  "manifest_version": 2,
  "name": "Send to JDownloader",
  "version": "1.0.2",
  "description": "Queue the current page URL, or the main video on it, in JDownloader 2 via My.JDownloader or local Click'n'Load.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "myjd.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Send to JDownloader",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "send-to-jdownloader@tomshomelab.github.io",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/tomshomelab/send-to-jdownloader/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
